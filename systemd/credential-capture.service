[Unit]
Description=Capture encrypted recovery credentials
After=default.target

[Service]
Type=oneshot
WorkingDirectory=%h/dotfiles

Environment=REPO_ROOT=%h/dotfiles
Environment=MACHINE_ID_FILE=%h/.config/dotfiles/machine-id
Environment=SOPS_AGE_KEY_FILE=%h/.config/sops/age/keys.txt

# Age escrow is intentionally not refreshed automatically because doing so
# requires the interactive recovery passphrase. Verify that an escrow artifact
# exists before refreshing the non-interactive credential backups.
ExecStart=/usr/bin/bash -c 'set -euo pipefail; machine_id="$(tr -d "[:space:]" < "$MACHINE_ID_FILE")"; recovery="$REPO_ROOT/secrets/$machine_id/age-key.age"; if [[ ! -f "$recovery" ]]; then echo "ERROR: age recovery artifact missing: $recovery" >&2; echo "Run scripts/capture-age-key.sh interactively before relying on scheduled credential capture." >&2; exit 1; fi'

# Routine capture treats the live machine as authoritative. The capture helpers
# still avoid rewriting unchanged ciphertext; --force only permits a real local
# key/config change to replace the repo working-tree recovery copy.
ExecStart=/usr/bin/bash %h/dotfiles/scripts/capture-ssh-credentials.sh --force
ExecStart=/usr/bin/bash %h/dotfiles/scripts/capture-wireguard-credentials.sh --force

StandardInput=null
TimeoutStartSec=10min
