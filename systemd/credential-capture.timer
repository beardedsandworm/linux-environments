[Unit]
Description=Daily encrypted credential recovery capture

[Timer]
# Changes are rare, but the helpers compare plaintext and do not rewrite
# unchanged recovery artifacts. Daily capture keeps the recovery gap small.
OnCalendar=*-*-* 04:15:00
RandomizedDelaySec=45m
AccuracySec=5m
Persistent=true
Unit=credential-capture.service

[Install]
WantedBy=timers.target
