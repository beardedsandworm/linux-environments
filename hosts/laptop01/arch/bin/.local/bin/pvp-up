#!/usr/bin/env bash
set -euo pipefail

SERVICE="wg-quick@wg-pvp.service"
INTERFACE="wg-pvp"

PVP_HOST="${PVP_HOST:-vpn.wormlogic.com}"
PVP_NATIVE_PORT="${PVP_NATIVE_PORT:-51821}"
PVP_WSTUNNEL_LOCAL_PORT="${PVP_WSTUNNEL_LOCAL_PORT:-51822}"
PVP_GATEWAY="${PVP_GATEWAY:-10.9.0.1}"
PVP_NATIVE_PROBE_SECONDS="${PVP_NATIVE_PROBE_SECONDS:-12}"
PVP_FALLBACK_PROBE_SECONDS="${PVP_FALLBACK_PROBE_SECONDS:-12}"
PVP_HANDSHAKE_MAX_AGE="${PVP_HANDSHAKE_MAX_AGE:-30}"

# Must be numerically before wg-quick's full-tunnel policy rules so the
# outer WSS connection to Heighliner stays on the physical network path.
BYPASS_RULE_PRIORITY="${PVP_BYPASS_RULE_PRIORITY:-10000}"

STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/pvp-helper"
TRANSPORT_FILE="$STATE_DIR/transport"
SERVER_IP_FILE="$STATE_DIR/server-ip"
WSTUNNEL_PID_FILE="$STATE_DIR/wstunnel.pid"
WSTUNNEL_LOG="$STATE_DIR/wstunnel.log"

mkdir -p "$STATE_DIR"

resolve_server_ip() {
    getent ahostsv4 "$PVP_HOST" \
        | awk '$1 ~ /^[0-9]+\./ {print $1; exit}'
}

get_peer() {
    sudo wg show "$INTERFACE" peers | awk 'NR == 1 {print $1}'
}

get_endpoint() {
    sudo wg show "$INTERFACE" endpoints | awk 'NR == 1 {print $2}'
}

latest_handshake() {
    local peer="$1"

    sudo wg show "$INTERFACE" latest-handshakes \
        | awk -v peer="$peer" '$1 == peer {print $2; exit}'
}

handshake_is_recent() {
    local peer="$1"
    local latest now

    latest="$(latest_handshake "$peer")"

    [[ "${latest:-0}" =~ ^[0-9]+$ ]] || return 1
    (( latest > 0 )) || return 1

    now="$(date +%s)"
    (( now - latest <= PVP_HANDSHAKE_MAX_AGE ))
}

probe_tunnel() {
    local peer="$1"
    local seconds="$2"
    local i

    # Generate traffic immediately. A reply is not required; sending traffic
    # is enough to make WireGuard initiate a handshake when the path works.
    for ((i = 0; i < seconds; i++)); do
        ping -c 1 -W 1 "$PVP_GATEWAY" >/dev/null 2>&1 || true

        if handshake_is_recent "$peer"; then
            return 0
        fi

        sleep 1
    done

    return 1
}

remove_bypass_rule() {
    local server_ip="${1:-}"

    [[ -n "$server_ip" ]] || return 0

    sudo ip rule del \
        priority "$BYPASS_RULE_PRIORITY" \
        to "$server_ip/32" \
        table main \
        2>/dev/null || true
}

add_bypass_rule() {
    local server_ip="$1"

    remove_bypass_rule "$server_ip"

    sudo ip rule add \
        priority "$BYPASS_RULE_PRIORITY" \
        to "$server_ip/32" \
        table main
}

stop_wstunnel() {
    local pid=""

    if [[ -f "$WSTUNNEL_PID_FILE" ]]; then
        pid="$(<"$WSTUNNEL_PID_FILE")"
    fi

    if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null || true

        for _ in {1..20}; do
            kill -0 "$pid" 2>/dev/null || break
            sleep 0.1
        done

        kill -9 "$pid" 2>/dev/null || true
    fi

    rm -f "$WSTUNNEL_PID_FILE"
}

wstunnel_is_running() {
    local pid=""

    [[ -f "$WSTUNNEL_PID_FILE" ]] || return 1
    pid="$(<"$WSTUNNEL_PID_FILE")"
    [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}

start_wstunnel() {
    local server_ip="$1"
    local pid

    if ! command -v wstunnel >/dev/null 2>&1; then
        echo "✗ Native WireGuard did not establish a handshake, and wstunnel is not installed."
        echo "  The TCP/443 fallback cannot start until the erebe/wstunnel client is installed."
        return 1
    fi

    stop_wstunnel
    : >"$WSTUNNEL_LOG"

    # Resolve Heighliner before enabling the full tunnel, then connect to that
    # IP directly. SNI and Host still identify vpn.wormlogic.com to Caddy and
    # TLS certificate verification remains enabled.
    nohup wstunnel client \
        --log-lvl WARN \
        --tls-sni-override "$PVP_HOST" \
        --tls-verify-certificate \
        -H "Host: $PVP_HOST" \
        -L "udp://127.0.0.1:${PVP_WSTUNNEL_LOCAL_PORT}:127.0.0.1:${PVP_NATIVE_PORT}?timeout_sec=0" \
        "wss://${server_ip}:443" \
        >"$WSTUNNEL_LOG" 2>&1 &

    pid=$!
    printf '%s\n' "$pid" >"$WSTUNNEL_PID_FILE"

    sleep 1

    if ! kill -0 "$pid" 2>/dev/null; then
        echo "✗ wstunnel exited during startup."
        echo "  Log: $WSTUNNEL_LOG"
        return 1
    fi
}

record_transport() {
    printf '%s\n' "$1" >"$TRANSPORT_FILE"
}

clear_helper_state() {
    local saved_server_ip=""

    if [[ -f "$SERVER_IP_FILE" ]]; then
        saved_server_ip="$(<"$SERVER_IP_FILE")"
    fi

    stop_wstunnel
    remove_bypass_rule "$saved_server_ip"
    rm -f "$TRANSPORT_FILE" "$SERVER_IP_FILE"
}

cleanup_failed_start() {
    local server_ip="${1:-}"

    sudo systemctl stop "$SERVICE" 2>/dev/null || true
    stop_wstunnel
    remove_bypass_rule "$server_ip"
    rm -f "$TRANSPORT_FILE" "$SERVER_IP_FILE"
}

server_ip="$(resolve_server_ip || true)"

if [[ -z "$server_ip" ]]; then
    echo "✗ Could not resolve $PVP_HOST before starting PVP."
    echo "  Complete any captive-portal login first, then try again."
    exit 1
fi

# If a previous fallback session is still genuinely active, do not disrupt it.
if systemctl is-active --quiet "$SERVICE"; then
    peer="$(get_peer)"
    endpoint="$(get_endpoint)"

    if [[ -z "$peer" ]]; then
        echo "✗ $SERVICE is active but no WireGuard peer was found."
        exit 1
    fi

    if [[ "$endpoint" == 127.0.0.1:* ]]; then
        if wstunnel_is_running && probe_tunnel "$peer" 3; then
            record_transport "wss-tcp-443-caddy"
            echo "✓ PVP is already active over WireGuard → Caddy/WSS/TCP/443"
            exit 0
        fi

        echo "• Existing WSS fallback state is stale; restarting from the native configuration..."
        sudo systemctl stop "$SERVICE"
        clear_helper_state
    elif probe_tunnel "$peer" 3; then
        record_transport "native-udp-$PVP_NATIVE_PORT"
        echo "✓ PVP is already active over native WireGuard UDP/$PVP_NATIVE_PORT"
        exit 0
    fi
fi

# Start from the authoritative wg-pvp.conf. Do not rewrite the native endpoint;
# wg-quick owns the normal configuration. Runtime endpoint changes are reserved
# exclusively for the TCP/443 fallback path below.
clear_helper_state
printf '%s\n' "$server_ip" >"$SERVER_IP_FILE"

echo "• Starting PVP..."
if ! systemctl is-active --quiet "$SERVICE"; then
    sudo systemctl start "$SERVICE"
fi

peer="$(get_peer)"

if [[ -z "$peer" ]]; then
    echo "✗ No peer found on $INTERFACE."
    cleanup_failed_start "$server_ip"
    exit 1
fi

# --------------------------------------------------
# 1. Native WireGuard UDP/51821
# --------------------------------------------------
echo "• Trying native WireGuard UDP/$PVP_NATIVE_PORT..."

if probe_tunnel "$peer" "$PVP_NATIVE_PROBE_SECONDS"; then
    record_transport "native-udp-$PVP_NATIVE_PORT"
    echo "✓ PVP active over native WireGuard UDP/$PVP_NATIVE_PORT"
    exit 0
fi

# --------------------------------------------------
# 2. WireGuard UDP carried through Caddy + WSS/TCP/443
# --------------------------------------------------
echo "• Native WireGuard did not establish a handshake; trying WSS/TCP/443 via Caddy..."

if ! command -v wstunnel >/dev/null 2>&1; then
    echo "✗ wstunnel is not installed; TCP/443 fallback is unavailable."
    cleanup_failed_start "$server_ip"
    exit 1
fi

# The outer TCP connection must remain outside wg-pvp's full-tunnel policy.
add_bypass_rule "$server_ip"

if ! start_wstunnel "$server_ip"; then
    cleanup_failed_start "$server_ip"
    exit 1
fi

# Extra encapsulation benefits from a smaller MTU. This is a runtime-only
# change and disappears when wg-pvp is stopped/restarted.
sudo ip link set dev "$INTERFACE" mtu 1300

# Only the fallback rewrites the peer endpoint: WireGuard sends UDP to the
# local wstunnel listener, which carries it over WSS/TCP/443 to Heighliner.
sudo wg set \
    "$INTERFACE" \
    peer "$peer" \
    endpoint "127.0.0.1:$PVP_WSTUNNEL_LOCAL_PORT"

if probe_tunnel "$peer" "$PVP_FALLBACK_PROBE_SECONDS"; then
    record_transport "wss-tcp-443-caddy"
    echo "✓ PVP active over WireGuard → Caddy/WSS/TCP/443"
    exit 0
fi

echo "✗ PVP failed over both native UDP/$PVP_NATIVE_PORT and WSS/TCP/443."
echo "  wstunnel log: $WSTUNNEL_LOG"
cleanup_failed_start "$server_ip"
exit 1
