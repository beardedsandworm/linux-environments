#!/usr/bin/env bash
set -euo pipefail

SERVICE="wg-quick@wormlogic.service"

if systemctl is-active --quiet "$SERVICE"; then
    sudo systemctl stop "$SERVICE"
    echo "WireGuard stopped."
else
    echo "WireGuard is already inactive."
fi

systemctl --no-pager --full status "$SERVICE" | sed -n '1,8p'
